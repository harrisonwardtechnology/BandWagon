# BandWagon web environment
#
# Copy to .env.local for local development. Never commit a real .env file.
# Production values belong in the Coolify environment / secret store only.
# Run `npm run release:check-env` (or `release:check-env:flomogo`) to verify a
# deployment without printing any secret values.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=BandWagon
APP_TAGLINE=Community-powered rides.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
PLATFORM_VENDOR_NAME=Harrison Ward Technology
PLATFORM_VENDOR_URL=https://harrisonward.com
DEFAULT_TIMEZONE=America/Chicago
DEFAULT_TIME_ZONE=America/Chicago
SUPPORT_EMAIL=support@example.com
PRIVACY_EMAIL=privacy@example.com
SECURITY_EMAIL=security@example.com
PLATFORM_OWNER_EMAIL=owner@example.com

# ---------------------------------------------------------------------------
# Database and cache (see apps/web/docker-compose.dev.yml for local services)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://bandwagon:bandwagon-dev-only@localhost:5432/bandwagon
DATABASE_SSL=false
# PEM certificate authority for the database server. When set with
# DATABASE_SSL=true the server certificate is verified instead of trusted blindly.
DATABASE_CA=
REDIS_URL=redis://localhost:6379
HEALTH_REQUIRE_DATABASE=false
HEALTH_REQUIRE_REDIS=false

# ---------------------------------------------------------------------------
# Security (32+ random characters each; generate with `openssl rand -base64 48`)
# ---------------------------------------------------------------------------
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
# Optional distinct key for lookup hashes; falls back to DATA_ENCRYPTION_KEY.
LOOKUP_HASH_KEY=
# Comma-separated previous keys kept readable during rotation.
DATA_ENCRYPTION_KEY_PREVIOUS=
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14
# Development only. Prints OTP codes to the server log instead of sending them.
AUTH_DEBUG_OTP=false
PASSKEYS_ENABLED=false

# ---------------------------------------------------------------------------
# Tenancy and hostnames
# ---------------------------------------------------------------------------
PLATFORM_HOSTNAMES=localhost:3000
TENANT_BASE_DOMAIN=
LEGACY_PLATFORM_HOSTNAMES=
LEGACY_TENANT_BASE_DOMAINS=

# ---------------------------------------------------------------------------
# Email (SMTP2GO)
# ---------------------------------------------------------------------------
SMTP2GO_API_KEY=
EMAIL_FROM=BandWagon <no-reply@example.com>

# ---------------------------------------------------------------------------
# SMS, RCS and voice (Twilio)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
# true keeps outbound messaging in sandbox mode so no real carrier traffic is sent.
MESSAGING_SANDBOX=true
NOTIFICATION_DELIVERY=
ORG_DEFAULT_MONTHLY_SMS_CAP_CENTS=
ADMIN_TEST_TOKEN=
ADMIN_TEST_PHONE=

# ---------------------------------------------------------------------------
# Web push (generate with `npm run push:generate-vapid`)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# ---------------------------------------------------------------------------
# Bot protection (Cloudflare Turnstile)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Google (calendar sync, geocoding, routes, Document AI)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_ROUTES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_DOCUMENT_AI_ENDPOINT=
GOOGLE_DOCUMENT_AI_COST_USD_PER_DOCUMENT=
GOOGLE_ROUTES_ESTIMATED_COST_USD_PER_CALL=
CALENDAR_LOOKAHEAD_DAYS=
CALENDAR_LOOKBACK_DAYS=
ROUTING_CACHE_MINUTES=

# ---------------------------------------------------------------------------
# Microsoft (calendar sync)
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/microsoft/callback

# ---------------------------------------------------------------------------
# Private object storage (S3-compatible; driver credential documents)
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Community support checkout (Stripe)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BANDWAGON_LOGO_FILE_ID=

# ---------------------------------------------------------------------------
# Custom domains (DoDomain, Cloudflare for SaaS)
# ---------------------------------------------------------------------------
DODOMAIN_API_BASE_URL=
DODOMAIN_SECRET_KEY=
DODOMAIN_WEBHOOK_SECRET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_SAAS_ZONE_ID=

# ---------------------------------------------------------------------------
# Scheduled jobs (each 32+ random characters; sent as `Authorization: Bearer`)
# ---------------------------------------------------------------------------
RIDE_REMINDER_CRON_SECRET=
SAFETY_CRON_SECRET=
SAFETY_MAINTENANCE_CRON_SECRET=
PRIVACY_MAINTENANCE_CRON_SECRET=
CALENDAR_SYNC_CRON_SECRET=
PLATFORM_BUDGET_CRON_SECRET=
DECOMMISSION_CRON_SECRET=
STATUS_MONITORING_CRON_SECRET=
SCHEDULER_DISABLED_TASKS=
ORGANIZATION_DECOMMISSION_RETENTION_DAYS=30
ACCOUNT_DELETION_GRACE_DAYS=
DRIVER_CONFLICT_WINDOW_MINUTES=
MAX_POOL_TIME_GAP_MINUTES=

# Background worker process (APP_ROLE=worker)
APP_ROLE=web
WORKER_CONCURRENCY=
WORKER_POLL_MS=
WORKER_LEASE_SECONDS=
WORKER_SHUTDOWN_GRACE_MS=
WORKER_KUMA_PUSH_URL=

# ---------------------------------------------------------------------------
# AI assistance (fail-closed; disabled unless an organization opts in)
# ---------------------------------------------------------------------------
AI_RUNTIME_ENABLED=false
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_ALLOW_HTTP=false
AI_FAST_MODEL=
AI_BALANCED_MODEL=
AI_DEEP_MODEL=
AI_REQUEST_TIMEOUT_MS=
AI_MAX_JOB_COST_MICROUSD=

# ---------------------------------------------------------------------------
# Monitoring and status
# ---------------------------------------------------------------------------
ERROR_MONITOR_INGEST_SECRET=
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=
GLITCHTIP_RELEASE=
GLITCHTIP_MAX_EVENTS_PER_MINUTE=
NEXT_PUBLIC_STATUS_URL=
NEXT_PUBLIC_STATUS_PAGE_URL=
NEXT_PUBLIC_HELP_DESK_URL=
STATUS_MONITOR_BRIDGE_URL=
STATUS_MONITOR_BRIDGE_TOKEN=
SOURCE_COMMIT=
